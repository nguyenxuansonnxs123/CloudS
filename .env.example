# Sao chép file này thành ".env.local" (local) hoặc cấu hình trực tiếp trên
# Hostinger (Environment Variables trong hPanel Node.js App) rồi điền giá trị thật.

# ---- Quản trị đơn hàng (/admin/orders) ----
# Mật khẩu đăng nhập trang quản trị. Bắt buộc phải đặt trước khi deploy thật.
ADMIN_PASSWORD=

# Chuỗi bí mật dùng để ký phiên đăng nhập admin — chỉ cần một chuỗi ngẫu nhiên dài, giữ bí mật.
ADMIN_SESSION_SECRET=

# ---- Email báo đơn hàng mới ----
# Có thể dùng Gmail: bật xác thực 2 bước rồi tạo "Mật khẩu ứng dụng" (App Password) tại
# https://myaccount.google.com/apppasswords — dùng mật khẩu đó cho SMTP_PASS (không phải mật khẩu Gmail thường).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Nếu để trống, mặc định gửi báo đơn hàng tới cloudsco2026@gmail.com (xem src/lib/order-email.ts).
ORDER_NOTIFICATION_EMAIL=
